# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here
 
# Model used for captioning images and answering questions
CLAUDE_MODEL=claude-sonnet-4-6
 
# Where uploaded PDFs and the vector store are persisted
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
 
# Retrieval
TOP_K=6
CHUNK_SIZE=800
CHUNK_OVERLAP=150
 